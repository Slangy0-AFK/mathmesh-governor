{
  "name": "HarnessControl",
  "type": "object",
  "properties": {
    "singleton_key": {
      "type": "string",
      "default": "GLOBAL",
      "description": "Always 'GLOBAL'. There is one control record for the whole harness."
    },
    "kill_all": {
      "type": "boolean",
      "default": false,
      "description": "Global emergency stop. When true, admission control denies every agent request before any model spend."
    },
    "kill_all_reason": {
      "type": "string",
      "default": "",
      "description": "Why the global stop was engaged"
    },
    "kill_all_engaged_by": {
      "type": "string",
      "default": "",
      "description": "Email of the operator who engaged the global stop"
    },
    "require_agent_key": {
      "type": "boolean",
      "default": true,
      "description": "When true, an agent must present its secret key to be admitted, and unknown agents are refused instead of auto-registered. Turning this off reverts identity to an unauthenticated claim \u2014 every other control then only governs a cooperative agent."
    },
    "max_runs_per_window": {
      "type": "number",
      "default": 20,
      "description": "Maximum admitted requests per agent per window. Bounds runaway loops and cost."
    },
    "window_seconds": {
      "type": "number",
      "default": 60,
      "description": "Rate limit window length in seconds"
    },
    "max_tokens_per_window": {
      "type": "number",
      "default": 40000,
      "description": "Maximum estimated tokens an agent may spend per token window, counting the harness's own judge and dedup calls. This is the real exhaustion bound \u2014 a request cap alone lets one agent spend a hundred times another agent's tokens in the same number of calls."
    },
    "token_window_seconds": {
      "type": "number",
      "default": 3600,
      "description": "Token budget window length in seconds. Longer than the rate-limit window on purpose: bursts are a rate problem, sustained spend is a budget problem."
    },
    "max_tokens_per_request": {
      "type": "number",
      "default": 6000,
      "description": "Hard ceiling on the estimated size of any single request, so one oversized payload cannot drain a whole window"
    },
    "enforce_token_budget": {
      "type": "boolean",
      "default": true,
      "description": "When false, spend is still recorded and visible but never denied \u2014 measurement without enforcement"
    },
    "require_grounding": {
      "type": "boolean",
      "default": true,
      "description": "When true, a response whose factual claims are not supported by the retrieved context is withheld from the caller and queued for human review instead of being returned as if it were verified"
    },
    "grounding_block_threshold": {
      "type": "number",
      "default": 1,
      "description": "How many unsupported claims are tolerated before the response is withheld. 1 means withhold on the first unsupported claim."
    },
    "loop_repeat_limit": {
      "type": "number",
      "default": 3,
      "description": "How many consecutive identical actions trip the circuit breaker"
    },
    "drift_strikes_before_revoke": {
      "type": "number",
      "default": 2,
      "description": "Drift events an agent may accumulate before the kill switch escalates from freeze to revoke. 1 means revoke on the first trip."
    },
    "auto_revoke_on_drift": {
      "type": "boolean",
      "default": true,
      "description": "When true, tripwire drift escalates to a hard revoke once the strike limit is reached. When false, drift only ever freezes."
    }
  },
  "required": [
    "singleton_key"
  ]
}