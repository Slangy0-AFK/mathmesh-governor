{
  "name": "AgentIdentity",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Unique agent identifier (e.g. FactChecker_1)"
    },
    "role": {
      "type": "string",
      "enum": [
        "reader",
        "writer",
        "admin",
        "tool_caller"
      ],
      "default": "reader",
      "description": "Agent role \u2014 determines allowed actions via tool gate"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "frozen"
      ],
      "default": "active",
      "description": "Agent lifecycle status. revoked = kill switch activated (terminal until an operator reinstates), frozen = reversible hold"
    },
    "key_hash": {
      "type": "string",
      "default": "",
      "description": "SHA-256 hash of this agent's secret key. The plaintext key is shown once at issue time and never stored, so a lost key must be rotated rather than recovered."
    },
    "key_last_four": {
      "type": "string",
      "default": "",
      "description": "Last four characters of the issued key, so an operator can tell two keys apart without seeing either"
    },
    "key_issued_at": {
      "type": "string",
      "default": "",
      "description": "ISO timestamp of the most recent key issue or rotation"
    },
    "key_auth_failures": {
      "type": "number",
      "default": 0,
      "description": "How many requests were rejected because they presented a wrong or missing key for this identity"
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Action allowlist for this agent. Empty array means use role defaults. ['*'] means all actions."
    },
    "session_nonce": {
      "type": "string",
      "default": "",
      "description": "Current session nonce for attribution and audit correlation"
    },
    "total_runs": {
      "type": "number",
      "default": 0,
      "description": "Total pipeline runs by this agent"
    },
    "halt_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this agent was halted by any gate"
    },
    "drift_count": {
      "type": "number",
      "default": 0,
      "description": "Number of tripwire drift events detected for this agent. Drives kill switch escalation."
    },
    "last_drift_nonce": {
      "type": "string",
      "default": "",
      "description": "The CSPRNG nonce from the most recent drift event (for forensic correlation)"
    },
    "rate_limit_hits": {
      "type": "number",
      "default": 0,
      "description": "How many times this agent was denied by the per-identity rate limiter"
    },
    "loop_trips": {
      "type": "number",
      "default": 0,
      "description": "How many times this agent tripped the server-side circuit breaker"
    },
    "revoked_reason": {
      "type": "string",
      "default": "",
      "description": "Why this agent was revoked/frozen (kill switch reason)"
    },
    "revoked_at": {
      "type": "string",
      "default": "",
      "description": "ISO timestamp of the most recent revoke or freeze"
    }
  },
  "required": [
    "agent_id",
    "role",
    "status"
  ]
}