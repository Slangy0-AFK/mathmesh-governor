{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "IDENTITY_VERIFIED",
        "IDENTITY_DENIED",
        "ADMISSION_PASS",
        "ADMISSION_DENIED",
        "RATE_LIMIT_EXCEEDED",
        "TOKEN_BUDGET_EXCEEDED",
        "TOKEN_SPEND",
        "LOOP_BREAKER_TRIPPED",
        "TOOL_GATE_PASS",
        "TOOL_GATE_DENIED",
        "GATE_PASS",
        "GATE_HALT",
        "CACHE_HIT",
        "CACHE_STORE",
        "OUTPUT_ATTRIBUTED",
        "OUTPUT_SIGNED",
        "GROUNDING_PASS",
        "GROUNDING_FAILED",
        "GROUNDING_NOT_CHECKED",
        "EGRESS_ALLOWED",
        "EGRESS_BLOCKED",
        "DRIFT_DETECTED",
        "TRIPWIRE_PASS",
        "AGENT_REVOKED",
        "AGENT_FROZEN",
        "AGENT_REINSTATED",
        "KILL_ALL_ENGAGED",
        "KILL_ALL_RELEASED",
        "CHAIN_VERIFIED",
        "CHAIN_BROKEN",
        "PIPELINE_COMPLETE"
      ],
      "description": "Type of audit event"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent that triggered this event"
    },
    "session_nonce": {
      "type": "string",
      "default": "",
      "description": "Session nonce for correlating events in the same session"
    },
    "event_nonce": {
      "type": "string",
      "default": "",
      "description": "Unique 256-bit CSPRNG nonce for this event"
    },
    "seq": {
      "type": "number",
      "default": 0,
      "description": "Position of this event in the hash chain. Gaps prove a deletion."
    },
    "prev_hash": {
      "type": "string",
      "default": "",
      "description": "row_hash of the preceding chain entry. The genesis row uses 64 zeros."
    },
    "row_hash": {
      "type": "string",
      "default": "",
      "description": "SHA-256 over this row's own facts plus prev_hash. Editing any recorded fact changes this hash and breaks every link after it, so tampering is detectable even though the table itself is still writable."
    },
    "chain_signature": {
      "type": "string",
      "default": "",
      "description": "HMAC-SHA256 of row_hash under the harness signing secret. Because the client never holds that secret, a forged row cannot be given a valid signature even by someone who can write to this table."
    },
    "output_hash": {
      "type": "string",
      "default": "",
      "description": "SHA-256 of the output text this event refers to, for attribution lookups"
    },
    "output_signature": {
      "type": "string",
      "default": "",
      "description": "HMAC-SHA256 signature over the output facts, proving this harness produced the output"
    },
    "gate": {
      "type": "string",
      "default": "",
      "description": "Which gate triggered this event (e.g. Admission, Egress, Base 2, Tripwire, Kill Switch)"
    },
    "action": {
      "type": "string",
      "default": "",
      "description": "The action being attempted when this event occurred"
    },
    "details": {
      "type": "string",
      "default": "",
      "description": "Human-readable event details for forensics"
    },
    "tokens_total": {
      "type": "number",
      "default": 0,
      "description": "Estimated tokens attributable to this event, when it spent any"
    },
    "drift_signal": {
      "type": "boolean",
      "default": false,
      "description": "True if this event was triggered by a tripwire drift detection"
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "",
        "none",
        "freeze",
        "revoke",
        "rate_limited",
        "kill_all",
        "budget_exhausted",
        "output_withheld"
      ],
      "default": "",
      "description": "What enforcement action the harness actually took as a result of this event"
    },
    "server_enforced": {
      "type": "boolean",
      "default": false,
      "description": "True if this verdict was decided server-side and therefore cannot be bypassed by the caller"
    },
    "halted_at": {
      "type": "string",
      "default": "",
      "description": "If this is a halt event, which gate halted the pipeline"
    }
  },
  "required": [
    "event_type",
    "agent_id"
  ]
}