{
  "name": "PipelineRun",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "The agent that submitted the payload"
    },
    "action": {
      "type": "string",
      "description": "The action the agent was attempting"
    },
    "raw_payload": {
      "type": "string",
      "description": "Original unfiltered payload text"
    },
    "clean_payload": {
      "type": "string",
      "description": "Payload after Base 2 noise stripping"
    },
    "compressed_payload": {
      "type": "string",
      "default": "",
      "description": "Payload after Base 3 prompt compression"
    },
    "votes": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Coordinate matrix votes from agents"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "HALTED"
      ],
      "description": "Final pipeline outcome"
    },
    "halted_at": {
      "type": "string",
      "enum": [
        "Kill Switch",
        "Admission",
        "Identity",
        "Tool Gate",
        "Rate Limit",
        "Token Budget",
        "Egress",
        "Base 2",
        "Base 3",
        "Base 10",
        "Base 12",
        "Base 60",
        "RAG",
        "Sonnet 4.6",
        "Tripwire",
        "Grounding",
        "Runtime",
        ""
      ],
      "default": "",
      "description": "Which gate halted the pipeline, if any"
    },
    "halt_reason": {
      "type": "string",
      "default": "",
      "description": "Why the pipeline was halted"
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "",
        "none",
        "freeze",
        "revoke",
        "rate_limited",
        "kill_all",
        "budget_exhausted",
        "output_withheld"
      ],
      "default": "",
      "description": "What the harness did to the agent or its output as a result of this run"
    },
    "authenticated": {
      "type": "boolean",
      "default": false,
      "description": "True if the agent proved its identity with a secret key on this run, rather than merely claiming an id"
    },
    "cache_hit": {
      "type": "boolean",
      "default": false,
      "description": "True if the response was served from the memoization cache"
    },
    "tokens_spent": {
      "type": "number",
      "default": 0,
      "description": "Estimated tokens this run charged to the agent's budget for generating the answer"
    },
    "judge_tokens": {
      "type": "number",
      "default": 0,
      "description": "Estimated tokens the harness spent judging this run \u2014 its own overhead, recorded rather than hidden"
    },
    "grounding_verdict": {
      "type": "string",
      "enum": [
        "",
        "grounded",
        "partly_grounded",
        "ungrounded",
        "not_checked"
      ],
      "default": "",
      "description": "Whether the response's factual claims traced back to the retrieved context"
    },
    "unsupported_claims": {
      "type": "number",
      "default": 0,
      "description": "How many factual claims could not be cited to the context"
    },
    "output_withheld": {
      "type": "boolean",
      "default": false,
      "description": "True if the harness refused to return the response because it failed cite-or-admit"
    },
    "rag_context": {
      "type": "string",
      "default": "",
      "description": "The grounding context retrieved by the RAG gate"
    },
    "rag_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Knowledge base sources used to ground the response"
    },
    "llm_response": {
      "type": "string",
      "default": "",
      "description": "The LLM response if payload passed (or cached response)"
    },
    "output_hash": {
      "type": "string",
      "default": "",
      "description": "SHA-256 of the exact output text. Binds this output to the agent and session that produced it."
    },
    "output_signature": {
      "type": "string",
      "default": "",
      "description": "HMAC-SHA256 over agent, session, action and output hash, produced server-side with a secret the client never sees. Unlike the plain hash, this proves origin rather than mere sameness."
    },
    "drift_detected": {
      "type": "boolean",
      "default": false,
      "description": "True if the tripwire detected canary engagement (drift)"
    },
    "drift_nonce": {
      "type": "string",
      "default": "",
      "description": "CSPRNG nonce from the tripwire halt event (for forensic correlation)"
    },
    "session_nonce": {
      "type": "string",
      "default": "",
      "description": "Session nonce for correlating audit events"
    },
    "tokens_saved_estimate": {
      "type": "number",
      "default": 0,
      "description": "Estimated characters of bloat stripped before tokenization"
    },
    "compression_saved_chars": {
      "type": "number",
      "default": 0,
      "description": "Characters removed by Base 3 prompt compression"
    },
    "gate_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "number"
          },
          "gate": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Per-gate verdicts for this run"
    }
  },
  "required": [
    "agent_id",
    "action",
    "status"
  ]
}